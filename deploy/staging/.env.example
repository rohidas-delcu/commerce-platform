# Copy to deploy/staging/.env in the deployment environment. Do not commit that file.
NODE_ENV=staging
HOST=0.0.0.0
PORT=3000
DATA_DRIVER=postgres
DEMO_AUTH_ENABLED=false
DATABASE_URL=postgresql://replace-with-staging-role@replace-with-staging-host:5432/commerce?schema=public
AUTH_OUTBOX_KEY=replace-with-64-lowercase-hex-characters
CORS_ORIGINS=https://admin.staging.example.com,https://shop.staging.example.com
OBJECT_STORAGE=s3
S3_REGION=replace-with-region
S3_BUCKET=replace-with-private-staging-bucket
NOTIFICATION_PROVIDER=ses
SES_REGION=replace-with-region
SES_FROM_EMAIL=replace-with-verified-sender@example.com
MERCHANT_APP_URL=https://admin.staging.example.com
STOREFRONT_APP_URL=https://shop.staging.example.com
COMMERCE_WORKER_ENABLED=false
