# Development API configuration. `pnpm dev:setup` copies the app-specific
# template to the ignored apps/api/.env and creates AUTH_OUTBOX_KEY if needed.
# See apps/api/.env.example for the complete documented template.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DRIVER=postgres
DATABASE_URL=postgresql://commerce:commerce@127.0.0.1:5432/commerce?schema=public
AUTH_OUTBOX_KEY=
DEMO_AUTH_ENABLED=false
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
OBJECT_STORAGE=local
DEV_STORAGE_DIR=.data/media
DEV_MAIL_DIR=.data/mail
NOTIFICATION_PROVIDER=development
COMMERCE_WORKER_ENABLED=false
MERCHANT_APP_URL=http://127.0.0.1:5173
STOREFRONT_APP_URL=http://127.0.0.1:5174
