NODE_ENV=development
PORT=3000
DATA_DRIVER=memory
DEMO_AUTH_ENABLED=true
# Required only for DATA_DRIVER=postgres
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce?schema=public

# Identity delivery payload encryption: securely generate 32 random bytes as hex.
# AUTH_OUTBOX_KEY=

# Staging is opt-in and requires the complete environment documented in
# docs/STAGING_DEPLOYMENT.md. Use deploy/staging/.env.example as the non-secret
# template; never place staging credentials in this development file.
