generator client {
  provider = "prisma-client"
  moduleFormat = "esm"
  importFileExtension = "js"
  output   = "../../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreStatus {
  DRAFT
  PUBLISHED
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Store {
  id             String      @id @default(uuid()) @db.Uuid
  ownerSubjectId String
  name           String
  handle         String      @unique
  countryCode    String      @default("IN") @db.VarChar(2)
  currencyCode   String      @default("INR") @db.VarChar(3)
  status         StoreStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  products       Product[]
  inventoryLogs  InventoryMovement[]

  @@index([ownerSubjectId])
}

model Product {
  version      Int           @default(0)
  id           String        @id @default(uuid()) @db.Uuid
  storeId      String        @db.Uuid
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name         String
  handle       String
  description  String        @default("")
  collection   String        @default("")
  priceMinor   BigInt
  compareMinor BigInt?
  status       ProductStatus @default(DRAFT)
  variants     ProductVariant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([storeId, handle])
  @@unique([id, storeId])
  @@index([storeId, status])
}

model ProductVariant {
  id        String              @id @default(uuid()) @db.Uuid
  storeId   String              @db.Uuid
  productId String              @db.Uuid
  product   Product             @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict)
  name      String
  sku       String
  stock     Int                 @default(0)
  movements InventoryMovement[]

  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@unique([productId, name])
  @@index([productId])
}

model InventoryMovement {
  id                String         @id @default(uuid()) @db.Uuid
  storeId           String         @db.Uuid
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variantId         String         @db.Uuid
  variant           ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)
  before            Int
  after             Int
  delta             Int
  reason            String
  note              String         @default("")
  actorSubjectId    String
  createdAt         DateTime       @default(now())

  @@index([storeId, createdAt])
}

model Identity {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  verifiedAt DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  audits IdentityAudit[]
  sessions IdentitySession[]
  challenges IdentityChallenge[]
}

model IdentitySession {
  id String @id @default(uuid()) @db.Uuid
  identityId String? @db.Uuid
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  csrfDigest String
  expiresAt DateTime
  absoluteExpiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  secrets IdentitySessionSecret[]
  @@index([identityId])
  @@index([expiresAt])
}

model IdentitySessionSecret {
  csrfDigest String
  digest String @id
  sessionId String @db.Uuid
  session IdentitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt DateTime?
}

model IdentityChallenge {
  digest String @id
  identityId String @db.Uuid
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  @@index([identityId, purpose])
  @@index([expiresAt])
}

model IdentityMail {
  id String @id @default(uuid()) @db.Uuid
  recipient String
  purpose String
  encryptedPayload String
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([createdAt])
}

model IdentityAudit {
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  identityId String? @db.Uuid
  action String
  createdAt DateTime @default(now())
  @@index([identityId, createdAt])
}

model IdentityThrottle {
  key String @id
  attempts Int
  expiresAt DateTime
  @@index([expiresAt])
}
