generator client {
  provider = "prisma-client"
  moduleFormat = "esm"
  importFileExtension = "js"
  output   = "../../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreStatus {
  DRAFT
  PUBLISHED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Store {
  customers Identity[]
  reservations InventoryReservation[]
  assets MediaAsset[]
  collections Collection[]
  merchantId String @db.Uuid
  merchant MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invitations MerchantInvitation[]
  creation StoreCreation?
  memberships StoreMembership[]
  settingsVersion Int @default(0)
  onboardingState String @default("IN_PROGRESS")
  timezone String @default("Asia/Kolkata")
  contactEmail String @default("")
  brandingName String @default("")
  suspended Boolean @default(false)
  archivedAt DateTime?
  @@unique([id, merchantId])
  id             String      @id @default(uuid()) @db.Uuid
  ownerSubjectId String
  name           String
  handle         String      @unique
  countryCode    String      @default("IN") @db.VarChar(2)
  currencyCode   String      @default("INR") @db.VarChar(3)
  status         StoreStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  products       Product[]
  inventoryLogs  InventoryMovement[]

  @@index([ownerSubjectId])
}

model Product {
  wishlists CustomerWishlist[]
  images ProductMedia[]
  collectionLinks CollectionProduct[]
  seoTitle String @default("")
  seoDescription String @default("")
  version      Int           @default(0)
  id           String        @id @default(uuid()) @db.Uuid
  storeId      String        @db.Uuid
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name         String
  handle       String
  description  String        @default("")
  collection   String        @default("")
  priceMinor   BigInt
  compareMinor BigInt?
  status       ProductStatus @default(DRAFT)
  variants     ProductVariant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([storeId, handle])
  @@unique([id, storeId])
  @@index([storeId, status])
}

model ProductVariant {
  reserved Int @default(0)
  reservationLines InventoryReservationLine[]
  active Boolean @default(true)
  priceMinor BigInt?
  compareMinor BigInt?
  options Json @default("{}")
  id        String              @id @default(uuid()) @db.Uuid
  storeId   String              @db.Uuid
  productId String              @db.Uuid
  product   Product             @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict)
  name      String
  sku       String
  stock     Int                 @default(0)
  movements InventoryMovement[]

  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@unique([productId, name])
  @@index([productId])
}

model InventoryMovement {
  id                String         @id @default(uuid()) @db.Uuid
  storeId           String         @db.Uuid
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variantId         String         @db.Uuid
  variant           ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)
  before            Int
  after             Int
  delta             Int
  reason            String
  note              String         @default("")
  actorSubjectId    String
  createdAt         DateTime       @default(now())

  @@index([storeId, createdAt])
}

model Identity {
  scopeKey String @default("merchant")
  customerStoreId String? @db.Uuid
  customerStore Store? @relation(fields:[customerStoreId],references:[id],onDelete:Restrict)
  addresses CustomerAddress[]
  wishlist CustomerWishlist[]
  @@unique([scopeKey,email])
  @@unique([id,scopeKey])
  @@unique([id,customerStoreId])
  issuedInvitations MerchantInvitation[]
  creations StoreCreation[]
  merchantMemberships MerchantMembership[]
  storeMemberships StoreMembership[]
  id String @id @default(uuid()) @db.Uuid
  email String
  name String
  passwordHash String
  verifiedAt DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  audits IdentityAudit[]
  sessions IdentitySession[]
  challenges IdentityChallenge[]
}

model IdentitySession {
  scopeKey String @default("merchant")
  id String @id @default(uuid()) @db.Uuid
  identityId String? @db.Uuid
  identity Identity? @relation(fields: [identityId,scopeKey], references: [id,scopeKey], onDelete: Restrict)
  csrfDigest String
  expiresAt DateTime
  absoluteExpiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  secrets IdentitySessionSecret[]
  @@index([identityId])
  @@index([expiresAt])
}

model IdentitySessionSecret {
  csrfDigest String
  digest String @id
  sessionId String @db.Uuid
  session IdentitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt DateTime?
}

model IdentityChallenge {
  digest String @id
  identityId String @db.Uuid
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  @@index([identityId, purpose])
  @@index([expiresAt])
}

model IdentityMail {
  scopeKey String @default("merchant")
  id String @id @default(uuid()) @db.Uuid
  recipient String
  purpose String
  encryptedPayload String
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([createdAt])
}

model IdentityAudit {
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  identityId String? @db.Uuid
  action String
  createdAt DateTime @default(now())
  @@index([identityId, createdAt])
}

model IdentityThrottle {
  key String @id
  attempts Int
  expiresAt DateTime
  @@index([expiresAt])
}


model MerchantAccount {
  id String @id @default(uuid()) @db.Uuid
  name String
  status String @default("ACTIVE")
  legacySubject String? @unique
  createdAt DateTime @default(now())
  invitations MerchantInvitation[]
  creations StoreCreation[]
  members MerchantMembership[]
  stores Store[]
}
model MerchantMembership {
  merchantId String @db.Uuid
  identityId String @db.Uuid
  role String @default("MEMBER")
  merchant MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  storeMemberships StoreMembership[]
  @@id([merchantId, identityId])
  @@index([identityId])
}
model StoreMembership {
  storeId String @db.Uuid
  merchantId String @db.Uuid
  identityId String @db.Uuid
  role String
  store Store @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  membership MerchantMembership @relation(fields: [merchantId, identityId], references: [merchantId, identityId], onDelete: Restrict)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  @@id([storeId, identityId])
  @@index([merchantId, identityId])
}

model StoreCreation {
  identityId String @db.Uuid
  key String
  merchantId String @db.Uuid
  storeId String @unique @db.Uuid
  digest String
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  merchant MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId,merchantId], references: [id,merchantId], onDelete: Restrict)
  @@unique([storeId,merchantId])
  @@id([identityId, key])
}

model MerchantInvitation {
  id String @id @default(uuid()) @db.Uuid
  digest String @unique
  merchantId String @db.Uuid
  storeId String? @db.Uuid
  email String
  role String
  inviterId String @db.Uuid
  inviter Identity @relation(fields: [inviterId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  merchant MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store Store? @relation(fields: [storeId,merchantId], references: [id,merchantId], onDelete: Restrict)
  @@index([merchantId,email])
}

model Collection {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store Store @relation(fields:[storeId],references:[id],onDelete:Restrict)
  name String
  handle String
  description String @default("")
  featured Boolean @default(false)
  position Int @default(0)
  version Int @default(0)
  status String @default("ACTIVE")
  products CollectionProduct[]
  @@unique([storeId,handle])
  @@unique([id,storeId])
  @@index([storeId,status,position])
}
model CollectionProduct {
  collectionId String @db.Uuid
  productId String @db.Uuid
  storeId String @db.Uuid
  position Int @default(0)
  collection Collection @relation(fields:[collectionId,storeId],references:[id,storeId],onDelete:Restrict)
  product Product @relation(fields:[productId,storeId],references:[id,storeId],onDelete:Restrict)
  @@id([collectionId,productId])
  @@index([collectionId,position,productId])
  @@index([productId,storeId])
}

model MediaAsset {
  id String @id @db.Uuid
  storeId String @db.Uuid
  store Store @relation(fields:[storeId],references:[id],onDelete:Restrict)
  key String @unique
  provider String
  contentType String
  size Int
  checksum String
  tokenDigest String
  status String @default("PENDING")
  expiresAt DateTime
  images ProductMedia[]
  @@unique([id,storeId])
  @@index([storeId,status])
  @@index([status,expiresAt])
}
model ProductMedia {
  storeId String @db.Uuid
  productId String @db.Uuid
  assetId String @db.Uuid
  position Int
  primary Boolean @default(false)
  altText String @default("")
  product Product @relation(fields:[productId,storeId],references:[id,storeId],onDelete:Restrict)
  asset MediaAsset @relation(fields:[assetId,storeId],references:[id,storeId],onDelete:Restrict)
  @@id([productId,assetId])
  @@index([assetId,storeId])
  @@index([productId,position])
}

model InventoryReservation {
  id String @id @db.Uuid
  storeId String @db.Uuid
  store Store @relation(fields:[storeId],references:[id],onDelete:Restrict)
  key String
  digest String
  status String @default("ACTIVE")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines InventoryReservationLine[]
  events InventoryReservationEvent[]
  @@unique([storeId,key])
  @@unique([id,storeId])
  @@index([storeId,status,expiresAt])
}
model InventoryReservationLine {
  reservationId String @db.Uuid
  storeId String @db.Uuid
  variantId String @db.Uuid
  quantity Int
  reservation InventoryReservation @relation(fields:[reservationId,storeId],references:[id,storeId],onDelete:Restrict)
  variant ProductVariant @relation(fields:[variantId,storeId],references:[id,storeId],onDelete:Restrict)
  @@id([reservationId,variantId])
  @@index([variantId,storeId])
}
model InventoryReservationEvent {
  id String @id @default(uuid()) @db.Uuid
  reservationId String @db.Uuid
  storeId String @db.Uuid
  reservation InventoryReservation @relation(fields:[reservationId,storeId],references:[id,storeId],onDelete:Restrict)
  status String
  actor String
  createdAt DateTime @default(now())
  @@unique([reservationId,status])
}

model CustomerAddress {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  storeId String @db.Uuid
  customer Identity @relation(fields:[customerId,storeId],references:[id,customerStoreId],onDelete:Restrict)
  name String
  line1 String
  line2 String @default("")
  city String
  region String
  postalCode String
  countryCode String @db.VarChar(2)
  phone String
  isDefault Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId,storeId])
}
model CustomerWishlist {
  customerId String @db.Uuid
  storeId String @db.Uuid
  productId String @db.Uuid
  customer Identity @relation(fields:[customerId,storeId],references:[id,customerStoreId],onDelete:Restrict)
  product Product @relation(fields:[productId,storeId],references:[id,storeId],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@id([customerId,productId])
  @@index([storeId,productId])
}
