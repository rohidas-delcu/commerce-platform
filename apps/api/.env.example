# Local API — copy to apps/api/.env, or run `pnpm dev:setup` to create it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# The authenticated admin and storefront require a migrated PostgreSQL database.
DATA_DRIVER=postgres
DATABASE_URL=postgresql://commerce:commerce@127.0.0.1:5432/commerce?schema=public
# Leave blank when copying; `pnpm dev:setup` generates a private 32-byte hex key.
AUTH_OUTBOX_KEY=
DEMO_AUTH_ENABLED=false

# Exact local browser origins; do not use a wildcard with credentialed sessions.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
MERCHANT_APP_URL=http://127.0.0.1:5173
STOREFRONT_APP_URL=http://127.0.0.1:5174

# Local-only storage and encrypted development mailbox.
OBJECT_STORAGE=local
DEV_STORAGE_DIR=.data/media
DEV_MAIL_DIR=.data/mail
NOTIFICATION_PROVIDER=development
COMMERCE_WORKER_ENABLED=false

# Set these only when intentionally testing external adapters; never commit values.
# S3_REGION=
# S3_BUCKET=
# SES_REGION=
# SES_FROM_EMAIL=
# SES_CONFIGURATION_SET=
